# Copy to .env and adjust. .env is gitignored — never commit it.

# The host port the viewer publishes on, and the address it publishes on.
#
# Loopback keeps it off the LAN so it can only be reached through the Caddy that terminates its
# TLS. It used to publish 8001 on every interface.
WEB_PORT=8001
WEB_BIND_ADDRESS=127.0.0.1
