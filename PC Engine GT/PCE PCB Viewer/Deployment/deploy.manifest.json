{
  // The PC Engine PCB Viewer deployment, described once so the console can drive it.
  //
  // Open it with Deploy.command in this project's folder. Note that "the repository root" for this
  // deployment is the viewer's own folder, not retrosix-resources — that repository holds board
  // scans, KiCad projects and documentation for a dozen consoles, and only this corner of it is a
  // hosted site.
  "schemaVersion": 1,

  "project": {
    "id": "pce-pcb-viewer",
    "name": "PC Engine PCB Viewer",
    "blurb": "An interactive board viewer for the PC Engine GT — scans, nets and component lookup in a browser.",
    "architecture": "**One container, one static Node server.** `node:18-alpine` runs `server.js`, which serves the viewer and its board assets. No database, no build step beyond `npm ci`, and no bind mount — everything it serves is baked into the image, so a redeploy is a new image and nothing else.\n\nTwo addresses are easy to confuse and they are different decisions. `HOST=0.0.0.0` is set **inside** the container because `server.js` defaults to `127.0.0.1`, which in a container means the container's own loopback — nothing published could reach it. `WEB_BIND_ADDRESS` is the address on the **host**, and that one is loopback on purpose so the viewer is only reachable through the Caddy that terminates its TLS.\n\nThe image is single-stage and does `COPY . .`, so anything left in the build context is baked into what the server serves. `Dockerfile.dockerignore` is what keeps secrets and local state out of it, and `guard security web-exposure` gates that.",
    "web": {
      "bindSetting": "WEB_BIND_ADDRESS",
      "portSetting": "WEB_PORT"
    },
    "links": [
      { "label": "Deployment notes", "path": "Deployment/Website/README.md" },
      { "label": "Demo copy notes", "path": "Deployment/Demo/README.md" }
    ]
  },

  "prereqs": [
    { "kind": "command-available", "command": "docker", "label": "Docker is installed" },
    {
      "kind": "docker-running",
      "label": "Docker is running",
      "remedy": "Start Docker Desktop (or `systemctl start docker` on a Linux host) and wait for it to come up."
    },
    { "kind": "disk-free", "path": ".", "minGb": 2, "label": "There is room for a new image" }
  ],

  "settings": [
    {
      "key": "WEB_PORT",
      "file": "Deployment/Website/.env",
      "label": "Web port",
      "help": "The host port the viewer publishes on. Caddy proxies to it, so changing it means changing Caddy too.",
      "type": "port",
      "default": "8001",
      "required": true
    },
    {
      "key": "WEB_BIND_ADDRESS",
      "file": "Deployment/Website/.env",
      "label": "Bind address",
      "help": "The host address the port is published on. Loopback keeps the viewer off the LAN so it can only be reached through the proxy. Not to be confused with HOST inside the container, which must be 0.0.0.0 or nothing published can reach the server at all.",
      "type": "text",
      "default": "127.0.0.1",
      "required": true
    },

    // The demo-live profile's own setting, in its own file so nothing a demo writes can land in the
    // production .env.
    {
      "key": "DEMO_PORT",
      "file": "Deployment/Demo/.env",
      "label": "Demo port",
      "help": "The host port the demo viewer publishes on, loopback only. Must differ from the live viewer's WEB_PORT — the demo deploy refuses to run otherwise.",
      "type": "port",
      "default": "8101",
      "required": true,
      "profiles": ["demo-live"]
    }
  ],

  "profiles": [
    {
      "id": "production",
      "label": "Production",
      "danger": "low",
      "openUrl": "http://localhost:{WEB_PORT}/",
      "steps": ["configure", "deploy"],
      "health": [
        {
          "kind": "http-status",
          "url": "http://localhost:{WEB_PORT}/",
          "label": "The viewer answers",
          "fixedBy": "deploy"
        },
        {
          "kind": "container-healthy",
          "name": "pce-boardview",
          "label": "The container is healthy and not restart-looping",
          "fixedBy": "deploy"
        },
        { "kind": "disk-free", "path": ".", "minGb": 2, "label": "There is disk headroom" }
      ],
      "manage": {
        "containers": [
          { "name": "pce-boardview", "role": "The board viewer" }
        ]
      }
    },
    // Demo from live: the SAME viewer code, stamped as a demo copy and in test mode, on its own port
    // and container, so a release can be stood up and tested on a clean machine before it goes live.
    //
    // NO live-pull / live-restore, deliberately. The viewer holds no data: no database, no uploads,
    // no keys, no volume — everything it serves is baked into the image. There is nothing live to
    // copy, so the copy is built from the release itself, as MailBridge's starts from an empty volume.
    // It sends nothing either, so test mode stubs nothing: the guard is the stamp and the switch
    // agreeing, which server.js checks at startup (see Deployment/Demo/README.md).
    {
      "id": "demo-live",
      "label": "Demo from live",
      "danger": "low",
      "openUrl": "http://localhost:{DEMO_PORT}/",
      "steps": ["demo-configure", "demo-deploy", "demo-live-test", "demo-stop"],
      // What a copy on another Site Host machine runs (`sitehost demo`). No group and no folder: there
      // is no live data to fetch (see above). demo-stop stays out, since the copy is left running.
      "demoCopy": { "steps": ["demo-configure", "demo-deploy", "demo-live-test"] },
      "health": [
        {
          "kind": "http-status",
          "url": "http://localhost:{DEMO_PORT}/health",
          "label": "The demo viewer is serving",
          "remedy": "Run \"Deploy the demo viewer\"."
        },
        {
          "kind": "http-json",
          "url": "http://localhost:{DEMO_PORT}/health",
          "field": "testMode",
          "equals": "true",
          "label": "Test mode is on",
          "remedy": "The viewer on the demo port is not in test mode. Stop it and run \"Deploy the demo viewer\" — the demo stack hard-wires PCE_VIEWER_TEST_MODE on."
        },
        {
          "kind": "http-json",
          "url": "http://localhost:{DEMO_PORT}/health",
          "field": "demoCopy",
          "equals": "demolive-pce-boardview",
          "label": "The viewer is stamped as a demo copy",
          "remedy": "The viewer on the demo port was not built from Deployment/Demo/Dockerfile. Run \"Deploy the demo viewer\"."
        },
        {
          "kind": "container-env",
          "namePattern": "demolive-pce-boardview",
          "key": "PCE_VIEWER_TEST_MODE",
          "equals": "true",
          "label": "The demo container was started with test mode on"
        }
      ],
      "manage": {
        "containers": [
          { "namePattern": "demolive-pce-boardview", "role": "Demo viewer (stamped demo copy, test mode on)" }
        ]
      }
    }
  ],

  "steps": [
    {
      "id": "configure",
      "title": "Configure the port",
      "importance": "required",
      "why": "Sets the host port and the address it is published on, in `Deployment/Website/.env`.\n\nThe compose file used to publish `8001:8080`, which binds `0.0.0.0` and puts the viewer on the LAN directly, around the Caddy that terminates its TLS. Loopback is the right answer for this site: nothing calls it from another container.",
      "detect": [
        { "kind": "env-key-set", "file": "Deployment/Website/.env", "key": "WEB_PORT" },
        { "kind": "env-key-set", "file": "Deployment/Website/.env", "key": "WEB_BIND_ADDRESS" }
      ],
      "inputs": [
        { "name": "WEB_PORT", "label": "Web port", "type": "port", "settingKey": "WEB_PORT" },
        { "name": "WEB_BIND_ADDRESS", "label": "Bind address", "type": "text", "settingKey": "WEB_BIND_ADDRESS" }
      ],
      "run": { "kind": "settings", "keys": ["WEB_PORT", "WEB_BIND_ADDRESS"] },
      "replaces": []
    },

    {
      "id": "deploy",
      "title": "Deploy the viewer",
      "importance": "required",
      "why": "Builds the image and starts the container. Nothing persists outside the image, so there is nothing to back up first and nothing a redeploy can leave behind.\n\nThe console waits for the viewer to answer rather than trusting that the container started — a container that is running is not an app that is serving, and a crash-looping one reports \"running\" in a plain listing.",
      "dependsOn": ["configure"],
      "detect": [
        { "kind": "http-status", "url": "http://localhost:{WEB_PORT}/" }
      ],
      "run": {
        "kind": "compose-up",
        "folder": "Deployment/Website",
        "files": ["docker-compose.yml"],
        "project": "pce-boardview",
        "waitForHealthy": "pce-boardview",
        "waitTimeoutSeconds": 300
      },
      "verify": [
        { "kind": "http-status", "url": "http://localhost:{WEB_PORT}/", "label": "The viewer answers" }
      ],
      "replaces": []
    },

    {
      "id": "demo-configure",
      "title": "Configure the demo viewer",
      "importance": "required",
      "why": "The demo viewer's port, in `Deployment/Demo/.env` — its own file, so nothing a demo writes can land in the production `.env`. Published on loopback only, and never the live viewer's port.",
      "detect": [
        { "kind": "env-key-set", "file": "Deployment/Demo/.env", "key": "DEMO_PORT" }
      ],
      "inputs": [
        { "name": "DEMO_PORT", "label": "Demo port", "type": "port", "settingKey": "DEMO_PORT" }
      ],
      "run": { "kind": "settings", "keys": ["DEMO_PORT"] },
      "replaces": []
    },

    {
      "id": "demo-deploy",
      "title": "Deploy the demo viewer",
      "importance": "required",
      "why": "Builds the demo image (`Deployment/Demo/Dockerfile`: the production image plus a demo stamp) and starts `demolive-pce-boardview` on the demo port with **test mode hard-wired on**.\n\nIt is a separate compose project from production on purpose: its own container, image tag and port, so it cannot touch a live viewer on the same box. The viewer refuses to start if the stamp and test mode ever disagree, so this image cannot run as production and production's cannot run as a demo.",
      "dependsOn": ["demo-configure"],
      "availableWhen": [
        {
          "kind": "env-key-matches",
          "file": "Deployment/Demo/.env",
          "key": "DEMO_PORT",
          "notEquals": "{WEB_PORT}",
          "label": "The demo viewer is on its own port, not the live viewer's"
        }
      ],
      "detect": [
        { "kind": "http-json", "url": "http://localhost:{DEMO_PORT}/health", "field": "testMode", "equals": "true" }
      ],
      "run": {
        "kind": "compose-up",
        "folder": "Deployment/Demo",
        "files": ["docker-compose.demo.yml"],
        "build": true,
        "waitForHealthy": "demolive-pce-boardview",
        "waitTimeoutSeconds": 300
      },
      "verify": [
        { "kind": "container-env", "namePattern": "demolive-pce-boardview", "key": "PCE_VIEWER_TEST_MODE", "equals": "true", "label": "Test mode is on in the demo container" },
        { "kind": "http-json", "url": "http://localhost:{DEMO_PORT}/health", "field": "demoCopy", "equals": "demolive-pce-boardview", "label": "The demo viewer reports its demo stamp" }
      ],
      "replaces": []
    },

    {
      "id": "demo-live-test",
      "title": "Test the demo viewer",
      "importance": "required",
      "why": "Runs the site's tests against the running demo: `/health` must report test mode on and the demo stamp, the viewer page and its script must be served, and the viewer's own `node:test` suite runs inside the deployed container — including the startup refusals for a stamp without test mode and test mode without a stamp. A target machine needs Docker and curl, not Node.",
      "dependsOn": ["demo-deploy"],
      "run": {
        "kind": "process",
        "program": "bash",
        "args": ["Deployment/Demo/Scripts/demo-live-test.sh"],
        "timeoutSeconds": 300
      },
      "replaces": []
    },

    {
      "id": "demo-stop",
      "title": "Stop the demo viewer",
      "importance": "optional",
      "why": "Stops the demo container, keeping it. Nothing is deleted, and there is no data to clean: the demo holds nothing that was not in the release.",
      "detect": [
        { "kind": "container-running", "namePattern": "demolive-pce-boardview", "expect": false }
      ],
      "run": { "kind": "container-stop", "namePattern": "demolive-pce-boardview" },
      "replaces": []
    }
  ],

  "retained": [
    {
      "path": "Scripts/run.py",
      "reason": "Runs the viewer natively for development, outside Docker. Not a deployment step."
    },
    {
      "path": "run.bat",
      "reason": "The Windows equivalent of Scripts/run.py — a local development launcher, not a deployment step."
    }
  ]
}
